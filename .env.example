# Hammurapi instance configuration (docker compose). All parameters are
# environment variables; see docs/configuration.md. install/install.sh fills
# this in and generates the secrets.

# ─── URLs ──────────────────────────────────────────────────────────
# Where people open Hammurapi. Register <PUBLIC_URL>/api/v1/auth/callback as the
# OAuth callback URL of your GitHub App / GitLab application.
PUBLIC_URL=http://localhost:8080

# ─── Git provider (one per instance) ───────────────────────────────
GIT_PROVIDER=gitlab
GIT_BASE_URL=https://gitlab.com
# Browser-facing URL for OAuth sign-in, if it differs from GIT_BASE_URL
GIT_OAUTH_URL=
GIT_REPO=product/specs
GIT_DEFAULT_BRANCH=main

GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Shared with the provider's webhook settings (<PUBLIC_URL>/hooks/v1/git).
WEBHOOK_SECRET=change-me

# ─── Bot account (PLT.HMR-0002): branches, commits and PRs of the agent in
# service repositories. GitHub uses the GitHub App above; GitLab a bot user token.
GITLAB_BOT_TOKEN=
# Provider login of the bot (its own review replies are ignored)
HAMMURAPI_BOT_LOGIN=hammurapi-bot

# Signature of CI results (POST /hooks/v1/ci-results); comma-separated during rotation
CI_RESULTS_SECRET=
# Base URL of /hooks/v1 for deploy result callbacks, if CI/CD cannot reach PUBLIC_URL
HOOKS_URL=

# ─── Runner: agent tasks (code generation, reverts) ─────────────────
# k8s (a Job per task, production) | local (subprocess of the worker, development)
RUNNER_EXECUTOR=local
RUNNER_TIMEOUT=2h
RUNNER_TOKEN_LIMIT=3000000
RUNNER_MAX_PARALLEL=10
RUNNER_MAX_PARALLEL_PER_REPO=1
WORKFLOW_MAX_ATTEMPTS=8
WORKFLOW_LEASE=2m

# ─── First global administrators (provider logins, comma-separated) ─
BOOTSTRAP_ADMINS=

# ─── Agent (ACP) ───────────────────────────────────────────────────
# AGENT_TARGET selects the Dockerfile.instance target: fake | claude
AGENT_TARGET=fake
ACP_AGENT_COMMAND=/usr/local/bin/hammurapi-fakeagent
ACP_AGENT_ARGS=
# KEY=VALUE;KEY=VALUE — e.g. ANTHROPIC_API_KEY=sk-ant-...
ACP_AGENT_ENV=
ACP_MAX_PROCESSES=4
ACP_SESSION_IDLE_TIMEOUT=30m

# ─── Infrastructure (compose service names) ────────────────────────
DATABASE_URL=postgres://hammurapi:hammurapi@postgres:5432/hammurapi?sslmode=disable
KAFKA_BROKERS=kafka:9092
S3_ENDPOINT=minio:9000
S3_BUCKET=hammurapi
S3_ACCESS_KEY=hammurapi
S3_SECRET_KEY=hammurapi123
S3_USE_SSL=false
# Voice needs the whisper service: docker compose --profile voice up -d
WHISPER_URL=http://whisper:9000

# 32 bytes, base64: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# ─── Limits ────────────────────────────────────────────────────────
UPLOAD_MAX_BYTES=20971520
IMPORT_MAX_BYTES=52428800
IMPORT_MAX_UNCOMPRESSED_BYTES=209715200
IMPORT_MAX_FILES=500

# ─── Observability ─────────────────────────────────────────────────
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
DEFAULT_LANGUAGE=en
